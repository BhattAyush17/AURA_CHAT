{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**/*": {
      "maxDuration": 15
    },
    "api/cron/consolidate": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/consolidate",
      "schedule": "0 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}